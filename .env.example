# Server
PORT=5000
NODE_ENV=production
# Set to true on Render free tier (0.1 vCPU) — clustering hurts more than it helps
# Only set to false if you have a paid plan with 2+ dedicated CPU cores
DISABLE_CLUSTER=true
REQUEST_TIMEOUT_MS=30000
# The public health URL of this backend (e.g., https://yourbackend.onrender.com/health).
# Used by the cron self-ping job to prevent Render free-tier spin-down.
API_URL=


# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
# Optional: disposable database used by npm test/CI instead of mongodb-memory-server
TEST_MONGODB_URI=mongodb://localhost:27017/cirql_test

# Redis (recommended in production for rate limits and Socket.io scaling)
REDIS_URL=redis://localhost:6379

# Monitoring
RELEASE_VERSION=
HEALTH_CHECK_SECRET=change_me_for_private_health_details
DEBUG_ERRORS=false
# Set to true in production after confirming frontend sends x-csrf-token header on all POST/PUT/PATCH/DELETE requests.
# Verify in browser DevTools → Network → any POST request → Request Headers → x-csrf-token must be present.
# Then also set CSRF_REQUIRE_TOKEN=true in your Render dashboard environment variables.
CSRF_REQUIRE_TOKEN=true

# JWT
JWT_SECRET=your_super_secret_64_byte_hex
JWT_REFRESH_SECRET=your_different_64_byte_hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Field-level encryption (mongoose-field-encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=your_32_byte_hex_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_FROM_NAME=CirQl Campus Marketplace
EMAIL_FROM_ADDRESS=noreply@cirql.in

# Frontend
FRONTEND_URL=https://cirql.in
FRONTEND_ORIGINS=https://cirql.in,https://www.cirql.in
# Use none when frontend and backend are on different sites/domains (requires HTTPS).
# Use strict/lax only when browser requests are same-site.
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Client build
# Set this in the frontend hosting platform, not the backend process.
VITE_API_ORIGIN=https://api.cirql.in
VITE_RELEASE_VERSION=

# Web Push
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:noreply@cirql.in
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# College domains
ALLOWED_COLLEGE_DOMAINS=kiet.edu,akgec.ac.in

# Admin
ADMIN_EMAILS=admin@cirql.in
